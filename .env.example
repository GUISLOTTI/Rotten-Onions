# Copie para .env e preencha. O .env NÃO vai para o git (está no .gitignore).
# Estes valores são referência; no .NET a config real fica no appsettings.

# ─── RabbitMQ ───────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=rotten
RABBITMQ_PASS=onions

# ─── SQL Server (instância local que você já tem) ───────
# Ajuste o Server para o nome da sua instância (ex.: localhost, .\SQLEXPRESS)
SQL_CONNECTION_STRING=Server=localhost;Database=RottenOnions;Trusted_Connection=True;TrustServerCertificate=True

# ─── TMDB (The Movie Database — API externa gratuita) ───
# Crie conta em https://www.themoviedb.org e gere a chave em Settings > API
TMDB_API_KEY=coloque-sua-chave-aqui
